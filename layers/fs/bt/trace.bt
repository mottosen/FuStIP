config =
{
    unstable_tseries=enable;
}

BEGIN
{
    print("bpftrace - FS Layer\n");

    // Process tier (fs has no device): comm OR pid (union). comm uses substring
    // match (sentinel "_" = unset); pid uses exact membership via @pid_allow,
    // populated from positional args $2.. (comma list split by the Makefile).
    // @has_pid distinguishes "no pid filter" from "pid not in set".
    @comm_filter = $1;

    @has_pid = 0;
    if ((int64)$2 > 0) { @pid_allow[(uint64)$2] = 1; @has_pid = 1; }
    if ((int64)$3 > 0) { @pid_allow[(uint64)$3] = 1; @has_pid = 1; }
    if ((int64)$4 > 0) { @pid_allow[(uint64)$4] = 1; @has_pid = 1; }
    if ((int64)$5 > 0) { @pid_allow[(uint64)$5] = 1; @has_pid = 1; }
    if ((int64)$6 > 0) { @pid_allow[(uint64)$6] = 1; @has_pid = 1; }
    if ((int64)$7 > 0) { @pid_allow[(uint64)$7] = 1; @has_pid = 1; }
    if ((int64)$8 > 0) { @pid_allow[(uint64)$8] = 1; @has_pid = 1; }
    if ((int64)$9 > 0) { @pid_allow[(uint64)$9] = 1; @has_pid = 1; }
}

// ── read() ──

tracepoint:syscalls:sys_enter_read
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_entered["read"] = count();
    @read_start[tid] = nsecs;
    // Active-I/O span: first data-syscall entry → last data-syscall exit. Used to
    // derive iops/throughput over the active window (not the whole trace lifetime).
    // Only data syscalls (read/write/pread64/pwrite64) — never metadata (openat,
    // close, …), which bracket the entire process and would re-inflate the window.
    @io_span_start["ns"] = min(nsecs);
}

tracepoint:syscalls:sys_exit_read
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    $now = nsecs;
    $ret = (int64)args.ret;

    if (@read_start[tid])
    {
        @sc_completed["read"] = count();
        @io_span_end["ns"] = max($now);

        if ($ret >= 0)
        {
            @sc_latencies["read"] = hist($now - @read_start[tid]);
            @sc_sizes["read"] = hist($ret);
            @sc_total_bytes["read"] = sum($ret);
        }

        delete(@read_start[tid]);
    }
    else
    {
        @sc_untracked["read"] = count();
    }
}

// ── write() ──

tracepoint:syscalls:sys_enter_write
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_entered["write"] = count();
    @write_start[tid] = nsecs;
    @io_span_start["ns"] = min(nsecs);
}

tracepoint:syscalls:sys_exit_write
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    $now = nsecs;
    $ret = (int64)args.ret;

    if (@write_start[tid])
    {
        @sc_completed["write"] = count();
        @io_span_end["ns"] = max($now);

        if ($ret >= 0)
        {
            @sc_latencies["write"] = hist($now - @write_start[tid]);
            @sc_sizes["write"] = hist($ret);
            @sc_total_bytes["write"] = sum($ret);
        }

        delete(@write_start[tid]);
    }
    else
    {
        @sc_untracked["write"] = count();
    }
}

// ── pread64() ──

tracepoint:syscalls:sys_enter_pread64
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_entered["pread64"] = count();
    @pread_start[tid] = nsecs;
    @io_span_start["ns"] = min(nsecs);
}

tracepoint:syscalls:sys_exit_pread64
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    $now = nsecs;
    $ret = (int64)args.ret;

    if (@pread_start[tid])
    {
        @sc_completed["pread64"] = count();
        @io_span_end["ns"] = max($now);

        if ($ret >= 0)
        {
            @sc_latencies["pread64"] = hist($now - @pread_start[tid]);
            @sc_sizes["pread64"] = hist($ret);
            @sc_total_bytes["pread64"] = sum($ret);
        }

        delete(@pread_start[tid]);
    }
    else
    {
        @sc_untracked["pread64"] = count();
    }
}

// ── pwrite64() ──

tracepoint:syscalls:sys_enter_pwrite64
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_entered["pwrite64"] = count();
    @pwrite_start[tid] = nsecs;
    @io_span_start["ns"] = min(nsecs);
}

tracepoint:syscalls:sys_exit_pwrite64
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    $now = nsecs;
    $ret = (int64)args.ret;

    if (@pwrite_start[tid])
    {
        @sc_completed["pwrite64"] = count();
        @io_span_end["ns"] = max($now);

        if ($ret >= 0)
        {
            @sc_latencies["pwrite64"] = hist($now - @pwrite_start[tid]);
            @sc_sizes["pwrite64"] = hist($ret);
            @sc_total_bytes["pwrite64"] = sum($ret);
        }

        delete(@pwrite_start[tid]);
    }
    else
    {
        @sc_untracked["pwrite64"] = count();
    }
}

// ── Additional syscall counts (enter-only) ──

tracepoint:syscalls:sys_enter_openat
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["openat"] = count();
}

tracepoint:syscalls:sys_enter_close
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["close"] = count();
}

tracepoint:syscalls:sys_enter_lseek
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["lseek"] = count();
}

tracepoint:syscalls:sys_enter_newfstatat
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["newfstatat"] = count();
}

tracepoint:syscalls:sys_enter_newfstat
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["newfstat"] = count();
}

tracepoint:syscalls:sys_enter_unlinkat
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["unlinkat"] = count();
}

tracepoint:syscalls:sys_enter_mkdirat
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["mkdirat"] = count();
}

tracepoint:syscalls:sys_enter_mmap
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["mmap"] = count();
}

tracepoint:syscalls:sys_enter_munmap
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["munmap"] = count();
}

// Asynchronous submission paths, whose I/O never appears as read/pread64: io_uring for modern
// engines, libaio for anything on the older interface. Counted only here, as for the other
// non-data syscalls — detailed mode is what carries their latency and batch sizes.
tracepoint:syscalls:sys_enter_io_uring_enter
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["io_uring_enter"] = count();
}

tracepoint:syscalls:sys_enter_io_submit
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["io_submit"] = count();
}

tracepoint:syscalls:sys_enter_io_getevents
/ (@comm_filter == "_" && @has_pid == 0) || strcontains(@comm_filter, comm) || @pid_allow[(uint64)pid] /
{
    @sc_count["io_getevents"] = count();
}

// ── Inflight time-series ──

interval:s:1
{
    @sc_inflight["read"] = tseries(@sc_entered["read"] - @sc_completed["read"], 1s, 7200);
    @sc_inflight["write"] = tseries(@sc_entered["write"] - @sc_completed["write"], 1s, 7200);
    @sc_inflight["pread64"] = tseries(@sc_entered["pread64"] - @sc_completed["pread64"], 1s, 7200);
    @sc_inflight["pwrite64"] = tseries(@sc_entered["pwrite64"] - @sc_completed["pwrite64"], 1s, 7200);
}

// ── Output ──

END
{
    print(@sc_entered);
    print(@sc_completed);
    print(@sc_untracked);
    print(@sc_count);
    print("");

    print(@sc_total_bytes);
    print(@io_span_start);
    print(@io_span_end);
    print("");

    print(@sc_sizes);
    print(@sc_latencies);
    print(@sc_inflight);


    clear(@sc_latencies);
    clear(@sc_sizes);
    clear(@sc_total_bytes);
    clear(@io_span_start);
    clear(@io_span_end);

    clear(@read_start);
    clear(@write_start);
    clear(@pread_start);
    clear(@pwrite_start);

    clear(@sc_entered);
    clear(@sc_completed);
    clear(@sc_untracked);
    clear(@sc_count);

    clear(@sc_inflight);

    delete(@comm_filter);
    delete(@has_pid);
    clear(@pid_allow);
}
